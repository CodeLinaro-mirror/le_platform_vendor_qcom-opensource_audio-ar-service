[Unit]
Description=AR init tasks after ar-audio-service.service being active and running
Requires=ar-audio-service.service
After=ar-audio-service.service
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
StartLimitBurst=5

[Service]
LimitMSGQUEUE=infinity

ExecStart=/usr/bin/ar_init_service 102 0xA2000017
ExecStartPost=/usr/bin/a2bplus_app a2b1.0 /etc/audio_a2bplus_cfg/quat.cfg
ExecStartPost=/usr/bin/a2bplus_app a2b2.0 /etc/audio_a2bplus_cfg/hsd_2node.cfg

Type=oneshot

[Install]
WantedBy=multi-user.target
